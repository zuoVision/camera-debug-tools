{
  "metrics": [
    {
      "id": "cam0_link_lock",
      "name": "Cam0 Link",
      "group": "Camera 0",
      "command": "sh -lc 'csi i2c 2 2 0xD6 0x1A'",
      "interval": 2,
      "parser": {
        "type": "regex",
        "pattern": "\\[0x[0-9a-fA-F]+\\]\\s*=\\s*(0x[0-9a-fA-F]+)",
        "group": 1,
        "bit": 3,
        "map": {
          "0": "LOST",
          "1": "LOCKED"
        }
      },
      "display": {
        "kind": "status",
        "goodValues": [
          "LOCKED"
        ]
      },
      "enabled": true,
      "timeout": 10
    },
    {
      "id": "cam0_video_lock",
      "name": "Cam0 Video",
      "group": "Camera 0",
      "command": "sh -lc 'csi i2c 2 2 0xD6 0x1dc'",
      "interval": 2,
      "parser": {
        "type": "regex",
        "pattern": "\\[0x[0-9a-fA-F]+\\]\\s*=\\s*(0x[0-9a-fA-F]+)",
        "group": 1,
        "bit": 0,
        "map": {
          "0": "LOST",
          "1": "LOCKED"
        }
      },
      "display": {
        "kind": "status",
        "goodValues": [
          "LOCKED"
        ]
      },
      "enabled": true,
      "timeout": 10
    }
  ]
}
