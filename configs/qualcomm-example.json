{
  "project": {"name": "Qualcomm Camera Board", "platform": "Qualcomm"},
  "target": {"transport": "ssh", "host": "192.168.1.10", "port": 22, "user": "root", "connectTimeout": 8},
  "variables": {"bus": 1, "device": "0x52", "link_reg": "0x0013", "video_reg": "0x0022"},
  "monitoring": {"metrics": [
    {"id": "link_lock", "name": "Link Lock", "group": "Camera 0", "command": "i2cdbgr r {bus} {device} {link_reg}", "interval": 2, "parser": {"type": "regex", "pattern": "(?:0x)?([0-9a-fA-F]+)\\s*$", "group": 1, "map": {"1": "LOCKED", "0": "UNLOCKED"}}, "display": {"kind": "status", "goodValues": ["LOCKED"]}},
    {"id": "video_lock", "name": "Video Lock", "group": "Camera 0", "command": "i2cdbgr r {bus} {device} {video_reg}", "interval": 2, "parser": {"type": "regex", "pattern": "(?:0x)?([0-9a-fA-F]+)\\s*$", "group": 1}, "display": {"kind": "status", "goodValues": ["1"]}}
  ]},
  "tests": [{"id": "camera_test", "name": "相机测试脚本", "description": "远端运行项目测试脚本", "command": "/opt/camera/tests/run.sh --camera {camera}", "params": [{"name": "camera", "label": "Camera ID", "type": "number", "default": 0}]}]
}
